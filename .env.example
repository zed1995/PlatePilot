# PlatePilot local development configuration.
# Copy to .env and fill in real values. .env is git-ignored and shared by both
# services in this repository; `make run*` loads it automatically.
# chat-service/.env.example and data-pipeline/.env.example carry the per-service
# subsets if you prefer to run a service with only its own variables.
APP_ENV=dev
LOG_LEVEL=info

# --- chat-service -----------------------------------------------------------
HTTP_ADDR=:8080
# Optional CORS allowlist (comma separated). Empty disables cross-origin access.
# HTTP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Restaurant search (chat-service, from M3 onward).
# Ranking weights. These encode a product decision — how far a soft match may
# reorder a hard-filtered list — so they are configuration rather than constants.
# RETRIEVAL_TOP_K=5
# RETRIEVAL_OVERSAMPLE=2
# RETRIEVAL_WEIGHT_STRUCTURED=1.0
# RETRIEVAL_WEIGHT_KEYWORD=0.5
# RETRIEVAL_WEIGHT_VECTOR=1.0
# RETRIEVAL_WEIGHT_QUALITY=0.2
# Per-channel switches, for A/B comparison and for running without one channel.
# RETRIEVAL_ENABLE_STRUCTURED=true
# RETRIEVAL_ENABLE_KEYWORD=true
# The vector channel needs an embedding provider below and an index built by the
# data pipeline. Turning it off is how a deployment runs before either exists.
# RETRIEVAL_ENABLE_VECTOR=true
# Bounds the on-demand query embedding. Separate from the pipeline's
# REQUEST_TIMEOUT because that default is sized for embedding a batch of long
# documents on a CPU model; an online recall embeds one short string.
# RETRIEVAL_EMBEDDING_TIMEOUT=5s

# Optional reranking. Leaving the provider unset switches the stage off, which is
# a supported way to run; MVP does not require a rerank model.
# RERANK_PROVIDER=
# RERANK_MODEL=
# RERANK_TIMEOUT=3s

# OpenAI-compatible chat provider (required from M4 onward)
# CHAT_PROVIDER=openai_compatible
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_API_KEY=<secret>
# CHAT_MODEL=<tool-capable-model-id>
# Optional per-node overrides. Each defaults to CHAT_MODEL, so a deployment that
# leaves them unset uses one model everywhere. Set them to put a small model
# behind extraction and a large one behind the answer: CHAT_MODEL_PLAN decides
# what the turn does next, CHAT_MODEL_ANSWER writes the final text, and
# CHAT_MODEL_EXTRACT reads the user's sentence into slots.
# All three models go to the same provider, base URL and API key.
# CHAT_MODEL_PLAN=<tool-capable-model-id>
# CHAT_MODEL_ANSWER=<writing-model-id>
# CHAT_MODEL_EXTRACT=<cheap-model-id>
# Optional per-request headers as JSON (e.g. OpenRouter attribution headers).
# CHAT_EXTRA_HEADERS_JSON={"X-Title":"PlatePilot","HTTP-Referer":"http://localhost:8080"}
# Bounds one non-streaming attempt; streaming calls follow the request context.
# CHAT_TIMEOUT=60s
# Additional attempts after the first one for 429/408/5xx/transport errors.
# 0 disables retries.
# CHAT_MAX_RETRIES=2
# Capability table — must match what the chosen model actually supports.
# CHAT_SUPPORTS_TOOLS=true
# CHAT_SUPPORTS_PARALLEL_TOOLS=false
# CHAT_SUPPORTS_JSON_SCHEMA=false
# CHAT_CONTEXT_TOKENS=32768

# Agent runtime knobs.
# Maximum plan->tools cycles per turn before the model is forced to answer.
# AGENT_MAX_TOOL_ROUNDS=5
# Bound on one tool invocation (search/evidence retrieval).
# AGENT_TOOL_TIMEOUT=15s

# Intent & slot layer (M5-01). The slot extraction is one structured call per
# turn; when it fails, times out, or no chat provider is configured, the turn
# continues on a rule-derived plan, so these knobs tune quality rather than
# availability.
# Bound on one structured slot-extraction call.
# AGENT_SLOT_EXTRACT_TIMEOUT=10s
# How many turns may be spent asking the user to disambiguate before the agent
# proceeds on its best assumption. Without a bound, a thread can ask forever.
# AGENT_MAX_CLARIFICATIONS=3
# Name-match similarity (0..1] at or above which a named restaurant counts as
# found. Lower finds more near-misses; higher refuses more real matches.
# AGENT_RESOLVE_MIN_SIMILARITY=0.55
# Top1/top2 similarity difference below which a name match is treated as
# ambiguous, and the user is asked which one they meant.
# AGENT_RESOLVE_AMBIGUITY_GAP=0.10

# Answer delivery. On by default: the composed answer is published incrementally
# so the first token reaches the client as it is generated. Streaming adds one
# event, `message.replace`, which carries a corrected whole body when the first
# generation cited something outside the turn's evidence set. Set to false for a
# client that cannot handle that frame; the answer then arrives as a single
# `message.delta` and is never replaced.
# PLATEPILOT_ANSWER_STREAMING=true

# Publishes phase.started / phase.finished (and the three ingress sub-steps)
# onto the SSE stream so the verification bench can render the turn as a
# sequence of named actions. On by default. A client that does not consume
# these events sees them as ignored frames; turning this off silences them
# entirely on the server side and is the documented rollback path.
# AGENT_PHASE_EVENTS=true

# Long-term memory writes (M5). On by default: the tool is the only way a
# long-term memory is created, and it is guarded by an input check that refuses
# anything the user did not ask for — so switching it off removes a capability
# the user asked for rather than closing a hole. Requires a memory store
# (PostgreSQL) to be configured.
# AGENT_MEMORY_WRITE_ENABLED=true

# Mock reservation feature (M5). The reservation tools and the confirmation
# gate are demo state; disabling removes the tools from the agent rather than
# making writes fail.
# RESERVATION_ENABLED=true
# How long an unconfirmed hold blocks capacity before it expires and the seats
# return. Must be > 0.
# RESERVATION_HOLD_TTL=5m
# Bumped when hold/booking policy changes so stale holds are distinguishable.
# RESERVATION_POLICY_VERSION=v1

# Administration console (chat-service /admin/v1/*).
# Disabled by default. When enabled the routes are additionally restricted to
# loopback peers (the serving process's local host); forwarded headers are not
# trusted. With it disabled the paths return 404.
# ADMIN_ENABLED=false
# ADMIN_DEFAULT_PAGE_SIZE=25
# ADMIN_MAX_PAGE_SIZE=100
# Maximum rejection rows returned on one batch detail.
# ADMIN_MAX_REJECTIONS=200

# --- data-pipeline ----------------------------------------------------------
# PIPELINE_DATA_DIR=data/raw/google_local
# PIPELINE_BATCH_SIZE=1000
# PIPELINE_WORKERS=4
# Minimum usable review text length (M1-06). Shorter text is dropped from
# evidence while the review still contributes to the rating sample.
# PIPELINE_MIN_REVIEW_CHARS=20
# Target number of demo restaurants; clamped to [2000, 5000] (M1-10).
# PIPELINE_DEMO_TARGET=3000
# Ingestion bounding box "south,west,north,east". The shipped meta file is
# US-wide, so this is what keeps the corpus to the five boroughs.
# PIPELINE_BBOX=40.49,-74.26,40.93,-73.68
# Administrative boundary geometry used to label borough_guess. Fetch it with
# the command in data/boundaries/README.md; the checksum is pinned in code.
# Empty disables boundary labelling entirely.
# PIPELINE_BOUNDARY_FILE=data/boundaries/nyc-borough-boundaries-water.geojson
# Fail instead of falling back to the approximate borough bounding boxes when
# the boundary file is missing or does not match its pinned checksum.
# PIPELINE_REQUIRE_BOUNDARIES=false

# --- shared (both services) -------------------------------------------------
# PostgreSQL (required from M1 onward).
# Start it with: docker compose -f deploy/docker-compose.yml up -d
# The image carries pgvector and PostGIS; migrations are applied by
# `data-pipeline migrate`.
POSTGRES_DSN=postgres://platepilot:platepilot@localhost:55432/platepilot?sslmode=disable
POSTGRES_DATABASE=platepilot
# Optional connection-pool / connect-timeout tuning
# POSTGRES_TIMEOUT=30s
# POSTGRES_CONNECT_TIMEOUT=10s
# POSTGRES_MAX_POOL_SIZE=8
# POSTGRES_MIN_POOL_SIZE=0

# Local Ollama embedding (required from M2 onward)
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS=1024

# Texts per embedding request (1..2048; 0/unset = 32). --batch overrides it.
# M2-06 says this must be measured on the real model, which needs it to be
# changeable without recompiling -- see docs/... E.29.
# EMBEDDING_MAX_BATCH=32

# One outbound request. Must cover the heaviest batch: representative-review
# documents average 2,878 characters, and 32 of them take ~52s on a local CPU
# model. Do not lower this back to 15s -- see docs/... E.32.
# REQUEST_TIMEOUT=180s
