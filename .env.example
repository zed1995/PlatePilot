# PlatePilot local development configuration.
# Copy to .env and fill in real values. .env is git-ignored and shared by both
# services in this repository.
APP_ENV=dev
LOG_LEVEL=info

# --- chat-service -----------------------------------------------------------
HTTP_ADDR=:8080
# Optional CORS allowlist (comma separated). Empty disables cross-origin access.
# HTTP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenAI-compatible chat provider (required from M4 onward)
# CHAT_PROVIDER=openai_compatible
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_API_KEY=<secret>
# CHAT_MODEL=<tool-capable-model-id>

# --- data-pipeline ----------------------------------------------------------
# PIPELINE_DATA_DIR=data/raw/google_local
# PIPELINE_BATCH_SIZE=1000
# PIPELINE_WORKERS=4

# --- shared (both services) -------------------------------------------------
# MongoDB Atlas (required from M1 onward)
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/
# MONGO_DATABASE=platepilot

# Local Ollama embedding (required from M2 onward)
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS=1024
